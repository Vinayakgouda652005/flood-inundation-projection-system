# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/flood_inundation_db

# Optional: Path to trained flood prediction model artifact
# Default resolves to backend/models/flood_prediction_model.pkl
# FLOOD_MODEL_PATH=models/flood_prediction_model.pkl
